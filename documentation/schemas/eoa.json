{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Previous AICTE EoA",
  "version": "2.3",
  "type": "object",
  "properties": {
    "institution_name": {
      "title": "Institution name",
      "type": "string"
    },
    "institution_address": {
      "title": "Institution address",
      "type": "string"
    },
    "institution_id": {
      "title": "Institution permanent ID",
      "type": "string"
    },
    "application_id": {
      "title": "Application ID",
      "type": "string"
    },
    "file_number": {
      "title": "File number / F.No.",
      "type": "string"
    },
    "academic_year": {
      "title": "Academic year",
      "type": "string"
    },
    "programmes": {
      "title": "Approved programmes / intake",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "title": "Course / branch",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "approved_intake": {
            "title": "Approved intake",
            "type": "integer"
          },
          "academic_year": {
            "title": "Academic year",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "approval_date": {
      "title": "Date of approval",
      "type": "string",
      "format": "date"
    },
    "deficiency_remarks": {
      "title": "Deficiency remarks",
      "type": "string"
    },
    "issuing_authority": {
      "title": "Issuing authority",
      "type": "string"
    },
    "qr_observation": {
      "title": "QR presence / visible text",
      "type": "string"
    },
    "digital_signature_observation": {
      "title": "Signature metadata / observation",
      "type": "string"
    }
  },
  "additionalProperties": false
}