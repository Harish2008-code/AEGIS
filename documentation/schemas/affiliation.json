{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "University / State affiliation",
  "version": "2.3",
  "type": "object",
  "properties": {
    "reference_number": {
      "title": "Reference / certificate number",
      "type": "string"
    },
    "university_name": {
      "title": "University name",
      "type": "string"
    },
    "academic_year": {
      "title": "Academic year",
      "type": "string"
    },
    "programmes": {
      "title": "Affiliated programmes",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "title": "Course / branch",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "academic_year": {
            "title": "Academic year",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "validity_period": {
      "title": "Validity period (as stated)",
      "type": "string"
    },
    "valid_from": {
      "title": "Valid from",
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "title": "Valid until",
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}