{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved intake / course records",
  "version": "2.3",
  "type": "object",
  "properties": {
    "programmes": {
      "title": "Course intake",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "title": "Course / branch",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "approved_intake": {
            "title": "Approved intake",
            "type": "integer"
          },
          "requested_intake": {
            "title": "Requested intake",
            "type": "integer"
          },
          "academic_year": {
            "title": "Academic year",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "affiliating_body": {
      "title": "Affiliating body",
      "type": "string"
    }
  },
  "additionalProperties": false
}