{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accreditation / Certification",
  "version": "2.3",
  "type": "object",
  "properties": {
    "accreditation_number": {
      "title": "Accreditation number",
      "type": "string"
    },
    "reference_number": {
      "title": "Reference / certificate number",
      "type": "string"
    },
    "institution_name": {
      "title": "Institution name",
      "type": "string"
    },
    "programmes": {
      "title": "Programme accreditation",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_name": {
            "title": "Course / branch",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "approved_intake": {
            "title": "Approved intake",
            "type": "integer"
          },
          "requested_intake": {
            "title": "Requested intake",
            "type": "integer"
          },
          "academic_year": {
            "title": "Academic year",
            "type": "string"
          },
          "accreditation_status": {
            "title": "Accreditation status",
            "type": "string"
          },
          "valid_from": {
            "title": "Valid from",
            "type": "string",
            "format": "date"
          },
          "valid_until": {
            "title": "Valid until",
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "grade": {
      "title": "Grade",
      "type": "string"
    },
    "score": {
      "title": "Score / CGPA",
      "type": "number"
    },
    "score_scale": {
      "title": "Score scale",
      "type": "number"
    },
    "issue_date": {
      "title": "Issue date",
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "title": "Expiry date",
      "type": "string",
      "format": "date"
    },
    "issuing_authority": {
      "title": "Issuing authority",
      "type": "string"
    },
    "seal_observation": {
      "title": "Visible seal text / observation",
      "type": "string"
    },
    "conditions": {
      "title": "Conditions / limitations",
      "type": "string"
    }
  },
  "additionalProperties": false
}